<view class="container home-page">
  <view class="card nav-card">
    <view class="nav-text">
      <text class="title">垃圾桶定位系统</text>
      <text class="subtitle">清街净巷 · 一键定位</text>
    </view>
    <view class="nav-actions">
      <button size="mini" class="btn-secondary" bindtap="goUpload">上传位置</button>
      <button size="mini" class="btn-primary" bindtap="goProfileOrLogin">{{authed ? "用户中心" : "登录"}}</button>
    </view>
  </view>

  <view class="card">
    <view class="filters">
      <view class="filter-item">
        <text class="label">半径(km)</text>
        <input class="input small-input" type="number" value="{{radius}}" bindinput="handleRadiusInput" />
      </view>
      <view class="filter-item">
        <text class="label">数量</text>
        <input class="input small-input" type="number" value="{{limit}}" bindinput="handleLimitInput" />
      </view>
      <view class="filter-item full-width">
        <text class="label">标签筛选</text>
        <picker mode="selector" range="{{tagOptions}}" bindchange="onTagChange" value="{{selectedTagIndex}}">
          <view class="picker-box">{{tagOptions[selectedTagIndex] || '选择标签'}}</view>
        </picker>
      </view>
    </view>

    <view class="actions">
      <button class="btn-secondary action-btn" loading="{{locating}}" bindtap="locateMe">定位我</button>
      <button class="btn-primary action-btn" loading="{{loading}}" bindtap="searchNearby">搜索附近</button>
    </view>
  </view>

  <view class="card map-card">
    <map
      id="trash-map"
      class="map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{scale}}"
      markers="{{markers}}"
      show-location
      bindmarkertap="handleMarkerTap"
    />
  </view>

  <view class="card list-card" wx:if="{{trashCans.length > 0}}">
    <view class="list-title">搜索结果（{{trashCans.length}}）</view>
    <block wx:for="{{trashCans}}" wx:key="id">
      <view class="trash-item">
        <view class="trash-header">
          <text class="trash-address">{{item.address || "垃圾桶位置"}}</text>
          <text class="trash-distance">{{item.distance_text}}</text>
        </view>

        <text class="trash-desc" wx:if="{{item.description}}">{{item.description}}</text>

        <view class="trash-tags" wx:if="{{item.tag_name}}">
          <text class="tag">{{item.tag_name}}</text>
        </view>

        <view class="trash-images" wx:if="{{item.image_urls.length > 0}}">
          <swiper class="image-swiper" indicator-dots="{{item.image_urls.length > 1}}" autoplay="{{false}}" circular>
            <swiper-item wx:for="{{item.image_urls}}" wx:key="index" wx:for-item="imgUrl">
              <image class="trash-image" src="{{imgUrl}}" mode="aspectFill" bindtap="previewImage" data-urls="{{item.image_urls}}" data-current="{{imgUrl}}" />
            </swiper-item>
          </swiper>
        </view>

        <view class="trash-actions">
          <button size="mini" class="btn-secondary mini-btn" bindtap="navigateToItem" data-id="{{item.id}}">导航</button>
          <button
            size="mini"
            class="mini-btn {{item.user_action === 1 ? 'btn-primary' : 'btn-secondary'}}"
            bindtap="handleLike"
            data-id="{{item.id}}"
          >
            👍 {{item.like_count || 0}}
          </button>
          <button
            size="mini"
            class="mini-btn {{item.user_action === -1 ? 'btn-danger' : 'btn-secondary'}}"
            bindtap="handleDislike"
            data-id="{{item.id}}"
          >
            👎 {{item.dislike_count || 0}}
          </button>
        </view>
      </view>
    </block>
  </view>

  <view class="card empty-card" wx:if="{{!loading && trashCans.length === 0}}">
    <text class="text-muted">暂无搜索结果，先点击"定位我"再搜索。</text>
  </view>

  <view class="version-bar" wx:if="{{version}}">
    <text class="version-text">v{{version}}</text>
  </view>
</view>
