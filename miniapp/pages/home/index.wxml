<view class="map-page">
  <!-- 顶部浮动搜索栏 -->
  <view class="search-bar">
    <view class="search-box" bindtap="openLocationPicker">
      <text class="search-text">{{currentAddress || '点击选择位置'}}</text>
    </view>
    <button class="search-btn" size="mini" bindtap="locateMe">定位</button>
  </view>

  <!-- 全屏地图 -->
  <map
    id="trash-map"
    class="full-map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    show-location
    bindmarkertap="handleMarkerTap"
    bindregionchange="handleRegionChange"
  />

  <!-- 定位按钮 -->
  <view class="locate-btn" bindtap="locateMe">⊕</view>

  <!-- 底部抽屉 -->
  <view class="drawer" wx:if="{{selectedItem}}">
    <view class="drawer-handle"></view>
    <view class="drawer-card">
      <view class="drawer-top">
        <text class="drawer-title">{{selectedItem.address || '垃圾桶位置'}}</text>
        <text class="drawer-tag" wx:if="{{selectedItem.tag_name}}">{{selectedItem.tag_name}}</text>
      </view>
      <text class="drawer-meta">步行 {{selectedItem.walk_time || '—'}} · 约 {{selectedItem.distance_text || '—'}}</text>
      <text class="drawer-desc" wx:if="{{selectedItem.description}}">{{selectedItem.description}}</text>
      <view class="drawer-images" wx:if="{{selectedItem.image_urls.length > 0}}">
        <block wx:for="{{selectedItem.image_urls}}" wx:key="index">
          <image class="drawer-img" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-urls="{{selectedItem.image_urls}}" data-current="{{item}}" />
        </block>
      </view>
      <view class="drawer-actions">
        <button class="btn-nav" size="mini" bindtap="navigateToItem" data-id="{{selectedItem.id}}">导航前往</button>
        <button class="btn-up {{selectedItem.user_action === 1 ? 'btn-up-active' : ''}}" size="mini" bindtap="handleLike" data-id="{{selectedItem.id}}">👍 {{selectedItem.like_count || 0}}</button>
        <button class="btn-down {{selectedItem.user_action === -1 ? 'btn-down-active' : ''}}" size="mini" bindtap="handleDislike" data-id="{{selectedItem.id}}">👎 {{selectedItem.dislike_count || 0}}</button>
      </view>
    </view>
  </view>

  <!-- 无结果提示 -->
  <view class="map-tip" wx:if="{{showTip && !loading}}">
    <text class="tip-text">点击地图标记查看详情，或点击「定位」重新搜索</text>
  </view>
</view>
