.map-page {
  position: relative;
  width: 100%;
  height: 100vh;
  background: #edf2eb;
}

/* 顶部浮动搜索栏 */
.search-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  padding-top: calc(env(safe-area-inset-top) + 16rpx);
  box-sizing: border-box;
  max-width: 100%;
}

.search-box {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 246, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(76, 105, 82, 0.14);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.search-text {
  font-size: 28rpx;
  color: #5f705f;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-btn {
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 252, 246, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(76, 105, 82, 0.14);
  color: #2e6b4c;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* 全屏地图 */
.full-map {
  width: 100%;
  height: 100%;
}

/* 定位按钮 */
.locate-btn {
  position: absolute;
  right: 28rpx;
  bottom: 280rpx;
  z-index: 10;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fffdf8;
  border: 1px solid rgba(76, 105, 82, 0.12);
  box-shadow: 0 8rpx 24rpx rgba(46, 70, 52, 0.12);
  display: grid;
  place-items: center;
  font-size: 36rpx;
  color: #2e6b4c;
}

/* 底部抽屉 */
.drawer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: rgba(255, 252, 246, 0.94);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1px solid rgba(76, 105, 82, 0.1);
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 24rpx calc(env(safe-area-inset-bottom) + 24rpx);
}

.drawer-handle {
  width: 72rpx;
  height: 8rpx;
  background: rgba(76, 105, 82, 0.2);
  border-radius: 999rpx;
  margin: 20rpx auto 16rpx;
}

.drawer-card {
  background: #fffdf8;
  border-radius: 24rpx;
  border: 1px solid rgba(76, 105, 82, 0.1);
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 70, 52, 0.06);
}

.drawer-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #203124;
  flex: 1;
}

.drawer-tag {
  font-size: 22rpx;
  background: rgba(46, 107, 76, 0.1);
  color: #2e6b4c;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
  white-space: nowrap;
}

.drawer-meta {
  display: block;
  font-size: 26rpx;
  color: #5f705f;
  margin-bottom: 10rpx;
}

.drawer-desc {
  display: block;
  font-size: 26rpx;
  color: #5f705f;
  line-height: 1.5;
  margin-bottom: 14rpx;
}

.drawer-images {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.drawer-img {
  flex: 1;
  height: 140rpx;
  border-radius: 16rpx;
}

.drawer-actions {
  display: flex;
  gap: 12rpx;
}

.drawer-actions button {
  flex: 1;
  min-height: 76rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.btn-nav {
  background: linear-gradient(135deg, #2e6b4c 0%, #3a7d5c 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(46, 107, 76, 0.22);
}

.btn-up {
  background: rgba(46, 107, 76, 0.08);
  color: #2e6b4c;
}

.btn-up-active {
  background: rgba(46, 107, 76, 0.18);
}

.btn-down {
  background: rgba(180, 75, 67, 0.08);
  color: #b44b43;
}

.btn-down-active {
  background: rgba(180, 75, 67, 0.18);
}

/* 地图提示 */
.map-tip {
  position: absolute;
  bottom: 300rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  background: rgba(255, 252, 246, 0.9);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(76, 105, 82, 0.14);
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #5f705f;
  white-space: nowrap;
}
