.profile-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: linear-gradient(180deg, #d8e8d4 0%, #edf2eb 200rpx, #edf2eb 100%);
}

/* ── 未登录 ── */
.unauthed {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx 60rpx;
  gap: 16rpx;
}
.unauthed-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(46, 107, 76, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.unauthed-icon { font-size: 52rpx; }
.unauthed-title { font-size: 34rpx; font-weight: 700; color: #203124; }
.unauthed-sub { font-size: 26rpx; color: #5f705f; text-align: center; line-height: 1.5; }
.login-btn { margin-top: 16rpx; width: 280rpx; }

/* ── Hero ── */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx 28rpx;
  gap: 10rpx;
}
.hero-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2e6b4c, #4a9e72);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(46, 107, 76, 0.28);
  overflow: hidden;
  margin-bottom: 4rpx;
}
.avatar-img { width: 100%; height: 100%; }
.avatar-initial { font-size: 48rpx; font-weight: 700; color: #fff; }
.hero-name { font-size: 36rpx; font-weight: 700; color: #203124; letter-spacing: 0.5rpx; }
.hero-username { font-size: 24rpx; color: #5f705f; }
.hero-stats {
  display: flex;
  align-items: center;
  gap: 0;
  margin-top: 12rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  padding: 16rpx 32rpx;
  gap: 32rpx;
}
.stat { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.stat-n { font-size: 32rpx; font-weight: 700; color: #203124; }
.stat-l { font-size: 22rpx; color: #5f705f; }
.stat-divider { width: 1rpx; height: 40rpx; background: rgba(76, 105, 82, 0.15); }

/* ── 通用 card ── */
.card {
  margin: 0 24rpx 16rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 22rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(44, 69, 49, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}
.card-title { font-size: 28rpx; font-weight: 700; color: #203124; }
.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.card-count { font-size: 24rpx; color: #5f705f; flex: 1; }
.loading-hint { font-size: 24rpx; color: #8a9e8a; }

/* ── 编辑表单 ── */
.edit-card { margin-bottom: 16rpx; }
.form-row { margin-bottom: 20rpx; }
.form-label { display: block; font-size: 24rpx; color: #5f705f; font-weight: 600; margin-bottom: 10rpx; }
.input {
  width: 100%;
  border: 1rpx solid rgba(76, 105, 82, 0.14);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #203124;
  box-sizing: border-box;
  min-height: 80rpx;
}
.textarea { min-height: 120rpx; }
.edit-actions { display: flex; gap: 16rpx; margin-top: 8rpx; }
.avatar-edit { display: inline-block; }
.avatar-img-sm { width: 100rpx; height: 100rpx; border-radius: 50%; }
.avatar-add {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(46, 107, 76, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #2e6b4c;
}

/* ── 功能菜单 ── */
.menu-card {
  margin: 0 24rpx 16rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(44, 69, 49, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
}
.menu-divider { height: 1rpx; background: rgba(76, 105, 82, 0.1); margin: 0 24rpx; }
.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(46, 107, 76, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-icon-wrap.admin { background: rgba(46, 107, 76, 0.12); }
.menu-icon { font-size: 30rpx; }
.menu-body { flex: 1; }
.menu-label { display: block; font-size: 28rpx; font-weight: 600; color: #203124; }
.menu-label.admin-label { color: #2e6b4c; }
.menu-sub { display: block; font-size: 22rpx; color: #5f705f; margin-top: 4rpx; }
.menu-arrow { font-size: 36rpx; color: #8a9e8a; font-weight: 300; }

/* ── 上传列表 ── */
.uploads-card { padding: 24rpx; }
.empty-hint { font-size: 28rpx; color: #5f705f; padding: 20rpx 0; }

/* 三格预览 */
.preview-grid {
  display: flex;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.preview-cell {
  flex: 1;
  border-radius: 14rpx;
  overflow: hidden;
  position: relative;
  height: 160rpx;
  background: rgba(46, 107, 76, 0.1);
}
.preview-cell-img { width: 100%; height: 100%; }
.preview-cell-placeholder { width: 100%; height: 100%; background: rgba(46, 107, 76, 0.1); }
.preview-cell-label {
  position: absolute;
  bottom: 8rpx;
  left: 10rpx;
  right: 10rpx;
  font-size: 20rpx;
  color: rgba(32, 49, 36, 0.75);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.trash-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(76, 105, 82, 0.08);
}
.trash-item:last-child { border-bottom: none; }
.item-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.item-thumb-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: rgba(46, 107, 76, 0.08);
  flex-shrink: 0;
}
.item-body { flex: 1; min-width: 0; }
.item-address { display: block; font-size: 28rpx; font-weight: 600; color: #203124; margin-bottom: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-meta { display: block; font-size: 22rpx; color: #8a9e8a; }
.item-actions { display: flex; flex-direction: column; gap: 8rpx; flex-shrink: 0; }

/* 编辑态 */
.edit-item { padding: 20rpx; }
.images-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 8rpx; }
.img-thumb { position: relative; width: 140rpx; height: 140rpx; }
.thumb-img { width: 100%; height: 100%; border-radius: 14rpx; }
.thumb-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: #b44b43;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}
.img-add {
  width: 140rpx;
  height: 140rpx;
  border: 2rpx dashed rgba(76, 105, 82, 0.22);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #5f705f;
  background: rgba(255, 255, 255, 0.6);
}

/* ── 分页 ── */
.pager { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.page-info { font-size: 26rpx; color: #5f705f; }

/* ── 退出登录 ── */
.logout-card {
  margin: 0 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 22rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(44, 69, 49, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}
.logout-text { font-size: 28rpx; font-weight: 600; color: #b44b43; }
