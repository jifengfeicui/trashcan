.profile-page {
  min-height: 100vh;
  padding: 18rpx 24rpx 180rpx;
  background: linear-gradient(180deg, #edf2eb 0%, #f4f2eb 56%, #eef1eb 100%);
}

.profile-page .card {
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid rgba(255, 255, 255, 0.66);
  border-radius: 22rpx;
  padding: 22rpx;
  box-shadow: 0 16rpx 34rpx rgba(44, 69, 49, 0.06);
  margin-bottom: 16rpx;
}

.nav-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #203124;
  letter-spacing: 1rpx;
}

.title-sm {
  font-size: 28rpx;
  font-weight: 600;
  color: #203124;
}

.nav-actions {
  display: flex;
  gap: 12rpx;
}

.user-line {
  display: flex;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.label {
  color: #5f705f;
  font-size: 26rpx;
  font-weight: 600;
}

.value {
  color: #203124;
  font-size: 26rpx;
  max-width: 66%;
  text-align: right;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.empty-text {
  color: #5f705f;
  font-size: 28rpx;
}

.trash-item {
  border: 1px solid rgba(76, 105, 82, 0.12);
  border-radius: 20rpx;
  margin-bottom: 14rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 6rpx 20rpx rgba(46, 70, 52, 0.05);
}

.trash-image {
  width: 100%;
  height: 240rpx;
}

.image-swiper {
  width: 100%;
  height: 240rpx;
}

.image-swiper image {
  width: 100%;
  height: 100%;
}

.trash-main {
  padding: 18rpx;
}

.trash-address {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #203124;
  margin-bottom: 8rpx;
}

.trash-desc {
  display: block;
  color: #5f705f;
  font-size: 26rpx;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.meta {
  display: block;
  color: #819082;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.trash-item-actions {
  display: flex;
  gap: 10rpx;
  padding: 0 14rpx 14rpx;
}

.edit-item {
  padding: 20rpx;
}

.edit-item .form-row {
  margin-bottom: 18rpx;
}

.edit-item .label {
  display: block;
  font-size: 26rpx;
  color: #5f705f;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.edit-item .input {
  border: 1px solid rgba(76, 105, 82, 0.14);
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #203124;
  min-height: 80rpx;
  box-sizing: border-box;
}

.edit-item .textarea {
  min-height: 120rpx;
  resize: none;
}

.edit-item-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.pager {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.page-info {
  font-size: 26rpx;
  color: #5f705f;
}

.user-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(46, 107, 76, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #2e6b4c;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #203124;
}

.edit-hint {
  font-size: 24rpx;
  color: #819082;
}

.edit-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #203124;
}

.form-row {
  margin-bottom: 20rpx;
}

.input {
  border: 1px solid rgba(76, 105, 82, 0.14);
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
  font-size: 28rpx;
  height: 84rpx;
  min-height: 84rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.86);
  color: #203124;
}

.edit-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.edit-item .images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.edit-item .image-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.edit-item .image-item .preview {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.edit-item .remove-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: #b44b43;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.edit-item .add-image-btn {
  width: 140rpx;
  height: 140rpx;
  border: 2rpx dashed rgba(76, 105, 82, 0.22);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5f705f;
  font-size: 48rpx;
  background: rgba(255, 255, 255, 0.6);
}

.admin-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(46, 107, 76, 0.1), rgba(46, 107, 76, 0.04));
  border: 1px solid rgba(46, 107, 76, 0.14);
  border-radius: 16rpx;
  margin-top: 16rpx;
  cursor: pointer;
}

.admin-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.admin-icon {
  font-size: 32rpx;
}

.admin-text {
  font-size: 28rpx;
  color: #2e6b4c;
  font-weight: 600;
}

.admin-arrow {
  font-size: 36rpx;
  color: #819082;
  font-weight: 300;
}
