.profile-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f7f1e4 0%, #f2e6ce 56%, #efe2c9 100%);
}

.profile-page .card {
  border-radius: 22rpx;
  border: 1px solid #e3d2af;
  background: #fffaf0;
  box-shadow: 0 10rpx 24rpx rgba(88, 46, 32, 0.09);
}

.nav-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #5a2a1f;
  letter-spacing: 1rpx;
}

.title-sm {
  font-size: 28rpx;
  font-weight: 600;
  color: #5a2a1f;
}

.nav-actions {
  display: flex;
  gap: 12rpx;
}

.profile-page .btn-secondary {
  background: #efe1c2;
  color: #6f4030;
  border: 1px solid #d9c29f;
}

.profile-page .btn-primary {
  background: linear-gradient(135deg, #a23626 0%, #be5536 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(162, 54, 38, 0.24);
}

.profile-page .btn-danger {
  background: #c93a3a;
  color: #ffffff;
}

.user-line {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.label {
  color: #634434;
  font-size: 26rpx;
  font-weight: 600;
}

.value {
  color: #5a2a1f;
  font-size: 26rpx;
  max-width: 66%;
  text-align: right;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.empty-text {
  color: #8d654a;
  font-size: 26rpx;
}

.trash-item {
  border: 1px solid #e3d2af;
  border-radius: 12rpx;
  margin-bottom: 14rpx;
  overflow: hidden;
  background: #fffdf7;
}

.trash-image {
  width: 100%;
  height: 240rpx;
}

.trash-images {
  width: 100%;
}

.image-swiper {
  width: 100%;
  height: 240rpx;
}

.image-swiper image {
  width: 100%;
  height: 100%;
}

.trash-main {
  padding: 14rpx;
}

.trash-address {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #5a2a1f;
  margin-bottom: 8rpx;
}

.trash-desc {
  display: block;
  color: #7a5a48;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.meta {
  display: block;
  color: #8d654a;
  font-size: 22rpx;
  margin-bottom: 6rpx;
}

.trash-item button {
  margin: 0 14rpx 14rpx;
}

.trash-item-actions {
  display: flex;
  gap: 8rpx;
  padding: 0 14rpx 14rpx;
}

.edit-item {
  padding: 20rpx;
}

.edit-item .form-row {
  margin-bottom: 16rpx;
}

.edit-item .label {
  display: block;
  font-size: 24rpx;
  color: #634434;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.edit-item .input {
  border: 1px solid #d8c2a2;
  border-radius: 8rpx;
  padding: 12rpx;
  font-size: 28rpx;
  background: #fffdf8;
}

.edit-item .textarea {
  min-height: 100rpx;
}

.edit-item-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.pager {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.page-info {
  font-size: 24rpx;
  color: #8d654a;
}

.user-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e3d2af;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #8d654a;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #5a2a1f;
}

.edit-hint {
  font-size: 22rpx;
  color: #8d654a;
}

.edit-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #5a2a1f;
}

.form-row {
  margin-bottom: 20rpx;
}

.avatar-edit {
  width: 120rpx;
  height: 120rpx;
  margin-top: 10rpx;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.input {
  border: 1px solid #d8c2a2;
  border-radius: 14rpx;
  padding: 16rpx;
  margin-top: 10rpx;
  font-size: 30rpx;
  height: 84rpx;
  min-height: 84rpx;
  box-sizing: border-box;
  background: #fffdf8;
  color: #2e2018;
}

.edit-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.edit-item .images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.edit-item .image-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
}

.edit-item .image-item .preview {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.edit-item .remove-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  background: #c93a3a;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.edit-item .add-image-btn {
  width: 140rpx;
  height: 140rpx;
  border: 2rpx dashed #d8c2a2;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8d654a;
  font-size: 40rpx;
}
