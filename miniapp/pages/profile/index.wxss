.nav-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.title-sm {
  font-size: 28rpx;
  font-weight: 600;
}

.nav-actions {
  display: flex;
  gap: 12rpx;
}

.user-line {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.label {
  color: #4f5b64;
  font-size: 26rpx;
}

.value {
  color: #1f2f24;
  font-size: 26rpx;
  max-width: 66%;
  text-align: right;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.empty-text {
  color: #637078;
  font-size: 26rpx;
}

.trash-item {
  border: 1px solid #e4ebe6;
  border-radius: 12rpx;
  margin-bottom: 14rpx;
  overflow: hidden;
}

.trash-image {
  width: 100%;
  height: 240rpx;
}

.trash-main {
  padding: 14rpx;
}

.trash-address {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.trash-desc {
  display: block;
  color: #5a6770;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.meta {
  display: block;
  color: #6c7880;
  font-size: 22rpx;
  margin-bottom: 6rpx;
}

.trash-item button {
  margin: 0 14rpx 14rpx;
}

.pager {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.page-info {
  font-size: 24rpx;
  color: #55616a;
}

.user-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #888;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
}

.edit-hint {
  font-size: 22rpx;
  color: #888;
}

.edit-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.form-row {
  margin-bottom: 20rpx;
}

.avatar-edit {
  width: 120rpx;
  height: 120rpx;
  margin-top: 10rpx;
}

.avatar-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.input {
  border: 1px solid #ddd;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-top: 10rpx;
  font-size: 28rpx;
}

.edit-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}
