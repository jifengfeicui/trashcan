.profile-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: linear-gradient(180deg, #d8e8d4 0%, #edf2eb 200rpx, #edf2eb 100%);
}

/* ── 未登录 ── */
.unauthed {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx 60rpx;
  gap: 16rpx;
}
.unauthed-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(46, 107, 76, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.unauthed-icon { font-size: 52rpx; }
.unauthed-title { font-size: 34rpx; font-weight: 700; color: #203124; }
.unauthed-sub { font-size: 26rpx; color: #5f705f; text-align: center; line-height: 1.5; }
.login-btn { margin-top: 16rpx; width: 280rpx; }

/* ── Hero ── */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx 28rpx;
  gap: 10rpx;
}
.hero-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2e6b4c, #4a9e72);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(46, 107, 76, 0.28);
  overflow: hidden;
  margin-bottom: 4rpx;
}
.avatar-img { width: 100%; height: 100%; }
.avatar-initial { font-size: 48rpx; font-weight: 700; color: #fff; }
.hero-name { font-size: 36rpx; font-weight: 700; color: #203124; letter-spacing: 0.5rpx; }
.hero-username { font-size: 24rpx; color: #5f705f; }
.hero-stats {
  display: flex;
  align-items: center;
  gap: 0;
  margin-top: 12rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  padding: 16rpx 32rpx;
  gap: 32rpx;
}
.stat { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.stat-n { font-size: 32rpx; font-weight: 700; color: #203124; }
.stat-l { font-size: 22rpx; color: #5f705f; }
.stat-divider { width: 1rpx; height: 40rpx; background: rgba(76, 105, 82, 0.15); }

/* ── 通用 card ── */
.card {
  margin: 0 24rpx 16rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 22rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(44, 69, 49, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}
.card-title { font-size: 28rpx; font-weight: 700; color: #203124; }
.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.card-count { font-size: 24rpx; color: #5f705f; flex: 1; }
.loading-hint { font-size: 24rpx; color: #8a9e8a; }

/* ── 编辑弹窗 ── */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.modal-sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 16rpx 32rpx 60rpx;
}
.modal-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(0, 0, 0, 0.12);
  margin: 0 auto 28rpx;
}
.modal-title { display: block; font-size: 32rpx; font-weight: 700; color: #203124; margin-bottom: 28rpx; }
.form-row { margin-bottom: 20rpx; }
.form-label { display: block; font-size: 24rpx; color: #5f705f; font-weight: 600; margin-bottom: 10rpx; }
.input {
  width: 100%;
  border: 1rpx solid rgba(76, 105, 82, 0.14);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #203124;
  box-sizing: border-box;
  min-height: 80rpx;
}
.edit-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.avatar-edit { display: inline-block; }
.avatar-img-sm { width: 100rpx; height: 100rpx; border-radius: 50%; }
.avatar-add {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(46, 107, 76, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #2e6b4c;
}

/* ── 功能菜单 ── */
.menu-card {
  margin: 0 24rpx 16rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(44, 69, 49, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
}
.menu-divider { height: 1rpx; background: rgba(76, 105, 82, 0.1); margin: 0 24rpx; }
.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(46, 107, 76, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.menu-icon-wrap.admin { background: rgba(46, 107, 76, 0.12); }
.menu-icon { font-size: 30rpx; }
.menu-body { flex: 1; }
.menu-label { display: block; font-size: 28rpx; font-weight: 600; color: #203124; }
.menu-label.admin-label { color: #2e6b4c; }
.menu-sub { display: block; font-size: 22rpx; color: #5f705f; margin-top: 4rpx; }
.menu-arrow { font-size: 36rpx; color: #8a9e8a; font-weight: 300; }

/* ── 最近上传横向滑动 ── */
.recent-section { margin: 0 24rpx 16rpx; }
.recent-title { font-size: 26rpx; color: #5f705f; display: block; margin-bottom: 12rpx; }
.recent-scroll { width: 100%; }
.recent-row { display: flex; gap: 12rpx; }
.recent-cell {
  flex-shrink: 0;
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background: rgba(46, 107, 76, 0.1);
}
.recent-img { width: 100%; height: 100%; }
.recent-placeholder { width: 100%; height: 100%; }
.recent-label {
  position: absolute;
  bottom: 8rpx;
  left: 10rpx;
  right: 10rpx;
  font-size: 20rpx;
  color: rgba(32, 49, 36, 0.8);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 退出登录 ── */
.logout-card {
  margin: 0 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 22rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(44, 69, 49, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}
.logout-text { font-size: 28rpx; font-weight: 600; color: #b44b43; }
