<view class="container profile-page">
  <view class="card nav-card">
    <text class="title">用户中心</text>
    <view class="nav-actions">
      <button size="mini" class="btn-secondary" bindtap="goHome">首页</button>
      <button size="mini" class="btn-primary" bindtap="goUpload">上传</button>
    </view>
  </view>

  <view class="card" wx:if="{{!authed}}">
    <text class="empty-text">当前未登录，请先登录后查看个人数据。</text>
    <button class="btn-primary" bindtap="goLogin">去登录</button>
  </view>

  <block wx:if="{{authed}}">
    <view class="card">
      <view class="user-header" bindtap="startEdit">
        <image wx:if="{{userInfo.avatar}}" class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">
          <text>{{userInfo.username[0]}}</text>
        </view>
        <view class="user-info">
          <text class="nickname">{{userInfo.nickname || userInfo.username}}</text>
          <text class="edit-hint">点击编辑资料</text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{editing}}">
      <view class="edit-title">编辑资料</view>
      <view class="form-row">
        <text class="label">头像</text>
        <view class="avatar-edit" bindtap="chooseAvatar">
          <image wx:if="{{editForm.avatar}}" src="{{editForm.avatar}}" mode="aspectFill" class="avatar-preview" />
          <view wx:else class="avatar-placeholder">
            <text>+</text>
          </view>
        </view>
      </view>
      <view class="form-row">
        <text class="label">昵称</text>
        <input class="input" value="{{editForm.nickname}}" data-field="nickname" bindinput="handleInput" placeholder="请输入昵称" />
      </view>
      <view class="edit-actions">
        <button size="mini" class="btn-secondary" bindtap="cancelEdit">取消</button>
        <button size="mini" class="btn-primary" bindtap="saveProfile" loading="{{loadingUser}}">保存</button>
      </view>
    </view>

    <view class="card">
      <view class="user-line">
        <text class="label">用户名</text>
        <text class="value">{{userInfo.username}}</text>
      </view>
      <view class="user-line" wx:if="{{userInfo.created_at}}">
        <text class="label">注册时间</text>
        <text class="value">{{userInfo.created_at}}</text>
      </view>
      <button class="btn-danger" bindtap="logout" wx:if="{{!editing}}">退出登录</button>
    </view>

    <view class="card">
      <view class="list-header">
        <text class="title-sm">我的上传（{{total}}）</text>
        <text class="text-muted" wx:if="{{loadingList}}">加载中...</text>
      </view>

      <view wx:if="{{!loadingList && trashCans.length === 0}}" class="empty-text">
        还没有上传记录，去上传一个吧。
      </view>

      <block wx:for="{{trashCans}}" wx:key="id">
        <view class="trash-item" wx:if="{{editingItem !== item.id}}">
          <image wx:if="{{item.image_url}}" class="trash-image" src="{{item.image_url}}" mode="aspectFill" />
          <view class="trash-main">
            <text class="trash-address">{{item.address || "未填写地址"}}</text>
            <text class="trash-desc" wx:if="{{item.description}}">{{item.description}}</text>
            <text class="meta">坐标：{{item.latitude}}, {{item.longitude}}</text>
            <text class="meta">创建时间：{{item.created_at}}</text>
          </view>
          <view class="trash-item-actions">
            <button size="mini" class="btn-secondary" bindtap="startEditItem" data-id="{{item.id}}">编辑</button>
            <button size="mini" class="btn-danger" bindtap="handleDelete" data-id="{{item.id}}">删除</button>
          </view>
        </view>

        <view class="trash-item edit-item" wx:if="{{editingItem === item.id}}">
          <view class="form-row">
            <text class="label">图片（最多3张）</text>
            <view class="images-grid">
              <block wx:for="{{editItemImages}}" wx:key="index">
                <view class="image-item">
                  <image class="preview" src="{{item}}" mode="aspectFill" />
                  <view class="remove-btn" bindtap="removeEditImage" data-index="{{index}}">×</view>
                </view>
              </block>
              <view class="add-image-btn" bindtap="chooseEditImage" wx:if="{{editItemImages.length < 3}}">
                <text>+</text>
              </view>
            </view>
          </view>
          <view class="form-row">
            <text class="label">地址</text>
            <input class="input" value="{{editItemForm.address}}" data-field="address" bindinput="handleItemInput" placeholder="地址" />
          </view>
          <view class="form-row">
            <text class="label">描述</text>
            <textarea class="input textarea" value="{{editItemForm.description}}" data-field="description" bindinput="handleItemInput" placeholder="描述" />
          </view>
          <view class="edit-item-actions">
            <button size="mini" class="btn-secondary" bindtap="cancelEditItem">取消</button>
            <button size="mini" class="btn-primary" bindtap="saveEditItem" loading="{{loadingList}}">保存</button>
          </view>
        </view>
      </block>

      <view class="pager" wx:if="{{totalPages > 1}}">
        <button size="mini" class="btn-secondary" bindtap="loadPrev" disabled="{{page <= 1}}">上一页</button>
        <text class="page-info">第 {{page}} / {{totalPages}} 页</text>
        <button size="mini" class="btn-secondary" bindtap="loadNext" disabled="{{page >= totalPages}}">下一页</button>
      </view>
    </view>
  </block>
</view>
