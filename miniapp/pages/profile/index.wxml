<view class="profile-page">

  <!-- 未登录 -->
  <view wx:if="{{!authed}}" class="unauthed">
    <view class="unauthed-avatar">
      <text class="unauthed-icon">👤</text>
    </view>
    <text class="unauthed-title">登录后查看个人中心</text>
    <text class="unauthed-sub">上传垃圾桶位置、管理你的贡献</text>
    <button class="btn-primary login-btn" bindtap="goLogin">去登录</button>
  </view>

  <!-- 已登录 -->
  <block wx:if="{{authed}}">

    <!-- Hero -->
    <view class="hero" bindtap="startEdit">
      <view class="hero-avatar">
        <image wx:if="{{userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill"/>
        <text wx:else class="avatar-initial">{{userInfo.username[0]}}</text>
      </view>
      <text class="hero-name">{{userInfo.nickname || userInfo.username}}</text>
      <text class="hero-username">@{{userInfo.username}}</text>
      <view class="hero-stats">
        <view class="stat">
          <text class="stat-n">{{total}}</text>
          <text class="stat-l">上传</text>
        </view>
        <view class="stat-divider"/>
        <view class="stat">
          <text class="stat-n">{{userInfo.likes_received || 0}}</text>
          <text class="stat-l">获赞</text>
        </view>
      </view>
    </view>

    <!-- 编辑资料表单 -->
    <view class="card edit-card" wx:if="{{editing}}">
      <text class="card-title">编辑资料</text>
      <view class="form-row">
        <text class="form-label">头像</text>
        <view class="avatar-edit" bindtap="chooseAvatar">
          <image wx:if="{{editForm.avatar}}" class="avatar-img-sm" src="{{editForm.avatar}}" mode="aspectFill"/>
          <view wx:else class="avatar-add"><text>+</text></view>
        </view>
      </view>
      <view class="form-row">
        <text class="form-label">昵称</text>
        <input class="input" value="{{editForm.nickname}}" data-field="nickname" bindinput="handleInput" placeholder="请输入昵称"/>
      </view>
      <view class="edit-actions">
        <button size="mini" class="btn-secondary" bindtap="cancelEdit">取消</button>
        <button size="mini" class="btn-primary" bindtap="saveProfile" loading="{{loadingUser}}">保存</button>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-card">
      <view class="menu-item" bindtap="startEdit">
        <view class="menu-icon-wrap">
          <text class="menu-icon">✏️</text>
        </view>
        <view class="menu-body">
          <text class="menu-label">编辑资料</text>
          <text class="menu-sub">昵称、头像</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-divider"/>
      <view class="menu-item" bindtap="goMyUploads">
        <view class="menu-icon-wrap">
          <text class="menu-icon">🗑️</text>
        </view>
        <view class="menu-body">
          <text class="menu-label">我的上传</text>
          <text class="menu-sub">{{total}} 个点位</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-divider" wx:if="{{userInfo.is_admin}}"/>
      <view class="menu-item" wx:if="{{userInfo.is_admin}}" bindtap="goAdmin">
        <view class="menu-icon-wrap admin">
          <text class="menu-icon">⚙️</text>
        </view>
        <view class="menu-body">
          <text class="menu-label admin-label">管理后台</text>
          <text class="menu-sub">管理员专属</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 最近上传横向滑动 -->
    <view class="recent-section" wx:if="{{trashCans.length > 0}}">
      <text class="recent-title">最近上传</text>
      <scroll-view class="recent-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="recent-row">
          <block wx:for="{{trashCans}}" wx:key="id">
            <view class="recent-cell">
              <image wx:if="{{item.image_urls.length > 0}}" class="recent-img" src="{{item.image_urls[0]}}" mode="aspectFill"/>
              <view wx:else class="recent-placeholder"/>
              <text class="recent-label">{{item.address || '未填写地址'}}</text>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-card" bindtap="logout">
      <text class="logout-text">退出登录</text>
    </view>

  </block>
</view>
