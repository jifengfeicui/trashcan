<view class="profile-page">

  <!-- 未登录 -->
  <view wx:if="{{!authed}}" class="unauthed">
    <view class="unauthed-avatar">
      <text class="unauthed-icon">👤</text>
    </view>
    <text class="unauthed-title">登录后查看个人中心</text>
    <text class="unauthed-sub">上传垃圾桶位置、管理你的贡献</text>
    <button class="btn-primary login-btn" bindtap="goLogin">去登录</button>
  </view>

  <!-- 已登录 -->
  <block wx:if="{{authed}}">

    <!-- Hero -->
    <view class="hero" bindtap="startEdit">
      <view class="hero-avatar">
        <image wx:if="{{userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill"/>
        <text wx:else class="avatar-initial">{{userInfo.username[0]}}</text>
      </view>
      <text class="hero-name">{{userInfo.nickname || userInfo.username}}</text>
      <text class="hero-username">@{{userInfo.username}}</text>
      <view class="hero-stats">
        <view class="stat">
          <text class="stat-n">{{total}}</text>
          <text class="stat-l">上传</text>
        </view>
        <view class="stat-divider"/>
        <view class="stat">
          <text class="stat-n">—</text>
          <text class="stat-l">获赞</text>
        </view>
      </view>
    </view>

    <!-- 编辑资料表单 -->
    <view class="card edit-card" wx:if="{{editing}}">
      <text class="card-title">编辑资料</text>
      <view class="form-row">
        <text class="form-label">头像</text>
        <view class="avatar-edit" bindtap="chooseAvatar">
          <image wx:if="{{editForm.avatar}}" class="avatar-img-sm" src="{{editForm.avatar}}" mode="aspectFill"/>
          <view wx:else class="avatar-add">
            <text>+</text>
          </view>
        </view>
      </view>
      <view class="form-row">
        <text class="form-label">昵称</text>
        <input class="input" value="{{editForm.nickname}}" data-field="nickname" bindinput="handleInput" placeholder="请输入昵称"/>
      </view>
      <view class="edit-actions">
        <button size="mini" class="btn-secondary" bindtap="cancelEdit">取消</button>
        <button size="mini" class="btn-primary" bindtap="saveProfile" loading="{{loadingUser}}">保存</button>
      </view>
    </view>

    <!-- 功能列表 -->
    <view class="menu-card">
      <view class="menu-item" bindtap="startEdit">
        <view class="menu-icon-wrap">
          <text class="menu-icon">✏️</text>
        </view>
        <view class="menu-body">
          <text class="menu-label">编辑资料</text>
          <text class="menu-sub">昵称、头像</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-divider"/>
      <view class="menu-item" wx:if="{{userInfo.is_admin}}" bindtap="goAdmin">
        <view class="menu-icon-wrap admin">
          <text class="menu-icon">⚙️</text>
        </view>
        <view class="menu-body">
          <text class="menu-label admin-label">管理后台</text>
          <text class="menu-sub">管理员专属</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 我的上传 -->
    <view class="card uploads-card">
      <view class="card-header">
        <text class="card-title">我的上传</text>
        <text class="card-count">{{total}} 个</text>
        <text class="loading-hint" wx:if="{{loadingList}}">加载中…</text>
      </view>

      <view wx:if="{{!loadingList && trashCans.length === 0}}" class="empty-hint">
        还没有上传记录，去上传一个吧。
      </view>

      <block wx:for="{{trashCans}}" wx:key="id">
        <!-- 查看态 -->
        <view class="trash-item" wx:if="{{editingItem !== item.id}}">
          <swiper wx:if="{{item.image_urls.length > 0}}" class="item-swiper" indicator-dots="{{item.image_urls.length > 1}}" circular>
            <swiper-item wx:for="{{item.image_urls}}" wx:key="index" wx:for-item="imgUrl">
              <image class="item-img" src="{{imgUrl}}" mode="aspectFill"/>
            </swiper-item>
          </swiper>
          <view class="item-body">
            <text class="item-address">{{item.address || '未填写地址'}}</text>
            <text class="item-desc" wx:if="{{item.description}}">{{item.description}}</text>
            <text class="item-meta">{{item.created_at}}</text>
          </view>
          <view class="item-actions">
            <button size="mini" class="btn-secondary" bindtap="startEditItem" data-id="{{item.id}}">编辑</button>
            <button size="mini" class="btn-danger" bindtap="handleDelete" data-id="{{item.id}}">删除</button>
          </view>
        </view>

        <!-- 编辑态 -->
        <view class="trash-item edit-item" wx:if="{{editingItem === item.id}}">
          <view class="form-row">
            <text class="form-label">图片（最多3张）</text>
            <view class="images-grid">
              <block wx:for="{{editItemImages}}" wx:key="index">
                <view class="img-thumb">
                  <image class="thumb-img" src="{{item}}" mode="aspectFill"/>
                  <view class="thumb-remove" bindtap="removeEditImage" data-index="{{index}}">×</view>
                </view>
              </block>
              <view class="img-add" bindtap="chooseEditImage" wx:if="{{editItemImages.length < 3}}">
                <text>+</text>
              </view>
            </view>
          </view>
          <view class="form-row">
            <text class="form-label">地址</text>
            <input class="input" value="{{editItemForm.address}}" data-field="address" bindinput="handleItemInput" placeholder="地址"/>
          </view>
          <view class="form-row">
            <text class="form-label">描述</text>
            <textarea class="input textarea" value="{{editItemForm.description}}" data-field="description" bindinput="handleItemInput" placeholder="描述"/>
          </view>
          <view class="edit-actions">
            <button size="mini" class="btn-secondary" bindtap="cancelEditItem">取消</button>
            <button size="mini" class="btn-primary" bindtap="saveEditItem" loading="{{loadingList}}">保存</button>
          </view>
        </view>
      </block>

      <view class="pager" wx:if="{{totalPages > 1}}">
        <button size="mini" class="btn-secondary" bindtap="loadPrev" disabled="{{page <= 1}}">上一页</button>
        <text class="page-info">{{page}} / {{totalPages}}</text>
        <button size="mini" class="btn-secondary" bindtap="loadNext" disabled="{{page >= totalPages}}">下一页</button>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-card" bindtap="logout">
      <text class="logout-text">退出登录</text>
    </view>

  </block>
</view>
