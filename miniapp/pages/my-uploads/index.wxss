.page {
  min-height: 100vh;
  padding: 16rpx 24rpx 180rpx;
  background: linear-gradient(180deg, #edf2eb 0%, #f4f2eb 100%);
}
.empty, .loading { padding: 60rpx 0; text-align: center; }
.empty-text, .muted { font-size: 28rpx; color: #5f705f; }

.item {
  background: rgba(255,255,255,0.88);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(44,69,49,0.06);
}
.item-swiper { width: 100%; height: 280rpx; }
.item-img { width: 100%; height: 100%; }
.item-body { padding: 16rpx 18rpx 8rpx; }
.item-address { display: block; font-size: 28rpx; font-weight: 700; color: #203124; margin-bottom: 6rpx; }
.item-desc { display: block; font-size: 24rpx; color: #5f705f; line-height: 1.5; margin-bottom: 6rpx; }
.item-meta { display: block; font-size: 22rpx; color: #8a9e8a; }
.item-actions { display: flex; gap: 12rpx; padding: 8rpx 18rpx 16rpx; }

.edit-item { padding: 20rpx; }
.form-row { margin-bottom: 18rpx; }
.form-label { display: block; font-size: 24rpx; color: #5f705f; font-weight: 600; margin-bottom: 8rpx; }
.input {
  width: 100%; border: 1rpx solid rgba(76,105,82,0.14); border-radius: 14rpx;
  padding: 14rpx 16rpx; font-size: 28rpx; background: rgba(255,255,255,0.86);
  color: #203124; min-height: 80rpx; box-sizing: border-box;
}
.textarea { min-height: 120rpx; }
.edit-actions { display: flex; gap: 16rpx; margin-top: 8rpx; }
.images-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 8rpx; }
.img-thumb { position: relative; width: 140rpx; height: 140rpx; }
.thumb-img { width: 100%; height: 100%; border-radius: 14rpx; }
.thumb-remove {
  position: absolute; top: -10rpx; right: -10rpx;
  width: 36rpx; height: 36rpx; background: #b44b43; color: #fff;
  border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}
.img-add {
  width: 140rpx; height: 140rpx; border: 2rpx dashed rgba(76,105,82,0.22);
  border-radius: 14rpx; display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; color: #5f705f; background: rgba(255,255,255,0.6);
}
.pager { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.page-info { font-size: 26rpx; color: #5f705f; }
