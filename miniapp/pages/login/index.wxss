.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding-top: 36rpx;
  padding-bottom: 36rpx;
  background: linear-gradient(180deg, #f8f2e5 0%, #f1e5cc 56%, #efe2c8 100%);
}

.login-card {
  width: 100%;
  border-radius: 24rpx;
  border: 1px solid #e3d4b6;
  background: #fffaf0;
  box-shadow: 0 14rpx 30rpx rgba(88, 46, 32, 0.1);
  padding: 28rpx;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #5a2a1f;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 22rpx;
  color: #8d654a;
}

.login-page .btn-secondary {
  background: #efe1c2;
  color: #6f4030;
  border: 1px solid #d9c29f;
}

.tabs {
  margin-top: 26rpx;
  display: flex;
  border: 2rpx solid #dcc9a8;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f8f1e0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  background: #f8f1e0;
  color: #77553b;
}

.tab-active {
  background: #9f3a28;
  color: #ffffff;
  font-weight: 600;
}

.form-row {
  margin-top: 22rpx;
}

.label {
  font-size: 25rpx;
  color: #644536;
  display: block;
  margin-bottom: 10rpx;
}

.input-lg {
  min-height: 86rpx;
  height: 86rpx;
  line-height: 86rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  border: 1px solid #d8c2a2;
  background: #fffdf7;
  color: #2d201a;
  font-size: 30rpx;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 30rpx;
  min-height: 86rpx;
  line-height: 86rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #a23626 0%, #be5536 100%);
  box-shadow: 0 8rpx 18rpx rgba(162, 54, 38, 0.28);
}

.error {
  margin-top: 18rpx;
  display: block;
  color: #b22e2e;
  font-size: 24rpx;
}

.wechat-btn {
  margin-top: 30rpx;
  min-height: 86rpx;
  line-height: 86rpx;
  border-radius: 14rpx;
  background: #07C160;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 30rpx;
}
