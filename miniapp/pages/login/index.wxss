.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 32rpx;
  background: linear-gradient(180deg, #edf2eb 0%, #f4f2eb 56%, #eef1eb 100%);
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(255, 255, 255, 0.66);
  box-shadow: 0 20rpx 48rpx rgba(46, 70, 52, 0.1);
  padding: 36rpx 32rpx;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #203124;
  letter-spacing: 1rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #5f705f;
}

.tabs {
  display: flex;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(76, 105, 82, 0.14);
  padding: 6rpx;
  margin-bottom: 28rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #5f705f;
  border-radius: 999rpx;
}

.tab-active {
  background: rgba(46, 107, 76, 0.14);
  color: #2e6b4c;
  font-weight: 700;
}

.form-row {
  margin-top: 22rpx;
}

.label {
  font-size: 26rpx;
  color: #5f705f;
  display: block;
  margin-bottom: 10rpx;
  font-weight: 600;
}

.input-lg {
  min-height: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  border: 1px solid rgba(76, 105, 82, 0.14);
  background: rgba(255, 255, 255, 0.86);
  color: #203124;
  font-size: 30rpx;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 32rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2e6b4c 0%, #3a7d5c 100%);
  color: white;
  box-shadow: 0 12rpx 24rpx rgba(46, 107, 76, 0.22);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.error {
  margin-top: 18rpx;
  display: block;
  color: #b44b43;
  font-size: 26rpx;
}

.wechat-btn {
  margin-top: 28rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #07c160;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 24rpx rgba(7, 193, 96, 0.18);
  border: none;
}
