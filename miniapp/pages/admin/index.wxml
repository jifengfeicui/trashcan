<view class="container admin-page">
  <view class="card nav-card">
    <view class="nav-text">
      <text class="title">管理后台</text>
      <text class="subtitle">管理所有上传的地点</text>
    </view>
    <button size="mini" class="btn-secondary" bindtap="goHome">返回首页</button>
  </view>

  <view class="card tab-card">
    <view class="tab-row">
      <view class="tab-item {{currentTab === 'place' ? 'active' : ''}}" data-tab="place" bindtap="switchTab">地点管理</view>
      <view class="tab-item {{currentTab === 'tag' ? 'active' : ''}}" data-tab="tag" bindtap="switchTab">标签管理</view>
    </view>
  </view>

  <block wx:if="{{currentTab === 'place'}}">
    <view class="card search-card">
      <view class="search-row">
        <input class="input" value="{{keyword}}" placeholder="搜索地址、描述、标签" bindinput="handleKeywordInput" />
        <button class="btn-primary" bindtap="search">搜索</button>
      </view>
      <view class="stats" wx:if="{{total > 0}}">
        <text class="text-muted">共 {{total}} 条记录</text>
      </view>
    </view>

    <view class="card list-card">
      <view wx:if="{{loading}}" class="loading">
        <text>加载中...</text>
      </view>

      <block wx:elif="{{list.length > 0}}">
        <block wx:for="{{list}}" wx:key="id">
          <view class="item">
            <view class="item-header">
              <text class="item-address">{{item.address || '位置' + item.id}}</text>
              <text class="item-date">{{item.created_at}}</text>
            </view>
            
            <view class="item-coords">
              <text class="text-muted">坐标: {{item.latitude}}, {{item.longitude}}</text>
            </view>

            <view class="item-uploader" wx:if="{{item.uploader_name}}">
              <text class="text-muted">上传者: {{item.uploader_name}}</text>
            </view>

            <view class="item-desc" wx:if="{{item.description}}">
              <text>{{item.description}}</text>
            </view>

            <view class="item-tags" wx:if="{{item.tag_name}}">
              <text class="tag">{{item.tag_name}}</text>
            </view>

            <view class="item-images" wx:if="{{item.image_url}}">
              <image class="thumb" src="{{item.image_url}}" mode="aspectFill" />
            </view>

            <view class="item-actions">
              <button size="mini" class="btn-primary" bindtap="openEditModal" data-item="{{item}}">编辑</button>
              <button size="mini" class="btn-danger" bindtap="deleteItem" data-item="{{item}}">删除</button>
            </view>
          </view>
        </block>
      </block>

      <view wx:else class="empty">
        <text class="text-muted">暂无数据</text>
      </view>
    </view>

    <view class="card" wx:if="{{totalPages > 1}}">
      <view class="pagination">
        <text class="page-info">第 {{page}} / {{totalPages}} 页</text>
      </view>
    </view>
  </block>

  <block wx:if="{{currentTab === 'tag'}}">
    <view class="card list-card">
      <view class="add-tag-row">
        <button size="mini" class="btn-primary" bindtap="createTag">新增标签</button>
      </view>
      <view wx:if="{{tagLoading}}" class="loading">
        <text>加载中...</text>
      </view>

      <block wx:elif="{{tagList.length > 0}}">
        <block wx:for="{{tagList}}" wx:key="id">
          <view class="tag-item">
            <view class="tag-info">
              <text class="tag-name">{{item.name}}</text>
              <text class="tag-count">{{item.count}} 个地点</text>
            </view>
            <button size="mini" class="btn-danger" bindtap="deleteTag" data-id="{{item.id}}" data-name="{{item.name}}">删除</button>
          </view>
        </block>
      </block>

      <view wx:else class="empty">
        <text class="text-muted">暂无标签</text>
      </view>
    </view>
  </block>

  <view class="version-bar">
    <text class="version-text">v0.1.0 admin</text>
  </view>
</view>

<view class="modal" wx:if="{{showEditModal}}">
  <view class="modal-mask" bindtap="closeEditModal"></view>
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">编辑地点</text>
      <text class="modal-close" bindtap="closeEditModal">×</text>
    </view>
    
    <view class="modal-body">
      <view class="form-row">
        <text class="label">地址</text>
        <input class="input" value="{{editAddress}}" data-field="editAddress" bindinput="handleInput" placeholder="地址" />
      </view>

      <view class="form-row">
        <text class="label">描述</text>
        <textarea class="input textarea" value="{{editDescription}}" data-field="editDescription" bindinput="handleInput" placeholder="描述" />
      </view>

      <view class="form-row">
        <text class="label">标签（逗号分隔）</text>
        <input class="input" value="{{editTags}}" data-field="editTags" bindinput="handleInput" placeholder="标签1, 标签2" />
      </view>
    </view>

    <view class="modal-footer">
      <button class="btn-secondary" bindtap="closeEditModal">取消</button>
      <button class="btn-primary" bindtap="saveEdit">保存</button>
    </view>
  </view>
</view>