.upload-page {
  min-height: 100vh;
  padding: 18rpx 24rpx 180rpx;
  background: linear-gradient(180deg, #edf2eb 0%, #f4f2eb 56%, #eef1eb 100%);
}

.nav-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.nav-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #203124;
  letter-spacing: 1rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #5f705f;
}

.form-card {
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid rgba(255, 255, 255, 0.66);
  border-radius: 22rpx;
  padding: 22rpx;
  box-shadow: 0 16rpx 34rpx rgba(44, 69, 49, 0.06);
  margin-bottom: 16rpx;
}

.form-row {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #5f705f;
  display: block;
  margin-bottom: 10rpx;
  font-weight: 600;
}

.mode-group {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.mode-item {
  color: #5f705f;
  font-size: 26rpx;
}

.actions {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  min-height: 82rpx;
  line-height: 82rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.input-lg {
  min-height: 84rpx;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  border: 1px solid rgba(76, 105, 82, 0.14);
  background: rgba(255, 255, 255, 0.86);
  color: #203124;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 140rpx;
  border-radius: 18rpx;
  border: 1px solid rgba(76, 105, 82, 0.14);
  background: rgba(255, 255, 255, 0.86);
  color: #203124;
  padding: 18rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  resize: none;
}

.hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #819082;
}

.tag-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.tag-picker {
  flex: 1;
}

.picker-box {
  min-height: 84rpx;
  line-height: 84rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  border: 1px solid rgba(76, 105, 82, 0.14);
  background: rgba(255, 255, 255, 0.86);
  color: #203124;
  font-size: 28rpx;
}

.upload-box {
  border: 2rpx dashed rgba(76, 105, 82, 0.22);
  border-radius: 20rpx;
  height: 220rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #5f705f;
  background: rgba(255, 255, 255, 0.6);
}

.images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.image-item .preview {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.remove-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #b44b43;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.add-image-btn {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed rgba(76, 105, 82, 0.22);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5f705f;
  font-size: 60rpx;
  background: rgba(255, 255, 255, 0.6);
}
