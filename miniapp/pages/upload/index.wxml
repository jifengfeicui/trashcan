<view class="upload-page">
  <view class="nav-card">
    <view class="nav-text">
      <text class="title">上传垃圾桶位置</text>
      <text class="subtitle">拾净城景 · 共护街巷</text>
    </view>
    <button size="mini" class="btn-secondary" bindtap="goHome">返回首页</button>
  </view>

  <view class="form-card">
    <view class="form-row">
      <text class="label">定位方式</text>
      <radio-group class="mode-group" bindchange="onModeChange">
        <label class="mode-item">
          <radio value="current" checked="{{locationMode === 'current'}}" /> 当前定位
        </label>
        <label class="mode-item">
          <radio value="manual" checked="{{locationMode === 'manual'}}" /> 手动输入
        </label>
      </radio-group>
    </view>

    <view class="actions" wx:if="{{locationMode === 'current'}}">
      <button class="btn-secondary action-btn" loading="{{locating}}" bindtap="getCurrentLocation">获取当前位置</button>
      <button class="btn-secondary action-btn" bindtap="chooseLocationByMap">地图选点</button>
    </view>

    <view class="form-row">
      <text class="label">经度</text>
      <input
        class="input input-lg"
        type="digit"
        value="{{form.longitude}}"
        data-field="longitude"
        bindinput="handleInput"
        bindblur="handleCoordBlur"
        placeholder="例如 116.397428"
      />
    </view>

    <view class="form-row">
      <text class="label">纬度</text>
      <input
        class="input input-lg"
        type="digit"
        value="{{form.latitude}}"
        data-field="latitude"
        bindinput="handleInput"
        bindblur="handleCoordBlur"
        placeholder="例如 39.90923"
      />
    </view>

    <view class="form-row">
      <text class="label">地址描述</text>
      <input
        class="input input-lg"
        value="{{form.address}}"
        data-field="address"
        bindinput="handleInput"
        placeholder="可自动填充，也可手动修改"
      />
      <text class="text-muted hint" wx:if="{{loadingAddress}}">正在反查地址...</text>
    </view>

    <view class="form-row">
      <text class="label">详细描述</text>
      <textarea
        class="input textarea"
        value="{{form.description}}"
        data-field="description"
        bindinput="handleInput"
        placeholder="可选：补充垃圾桶环境说明"
      />
    </view>

    <view class="form-row">
      <text class="label">标签</text>
      <view class="tag-row">
        <picker class="tag-picker" mode="selector" range="{{tagOptions}}" bindchange="onTagChange" value="{{selectedTagIndex}}">
          <view class="picker-box">{{tagOptions[selectedTagIndex]}}</view>
        </picker>
        <button size="mini" class="btn-secondary" bindtap="addNewTag">新增</button>
      </view>
    </view>

    <view class="form-row">
      <text class="label">上传图片（可选，最多3张）</text>
      <view class="images-grid" wx:if="{{imagePaths.length > 0}}">
        <block wx:for="{{imagePaths}}" wx:key="index">
          <view class="image-item">
            <image class="preview" src="{{item}}" mode="aspectFill" />
            <view class="remove-btn" bindtap="removeImage" data-index="{{index}}">×</view>
          </view>
        </block>
        <view class="add-image-btn" bindtap="chooseImage" wx:if="{{imagePaths.length < maxImages}}">
          <text>+</text>
        </view>
      </view>

      <view class="upload-box" bindtap="chooseImage" wx:if="{{imagePaths.length === 0}}">
        <text>点击选择图片</text>
      </view>
    </view>

    <view class="actions">
      <button class="btn-primary action-btn" loading="{{submitting}}" bindtap="submit">提交</button>
      <button class="btn-secondary action-btn" bindtap="resetForm">重置</button>
    </view>
  </view>
</view>
